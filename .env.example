# --- Webhook ---
PORT=8080
LOG_LEVEL=info                    # debug also logs every order API call
# Basic auth that Dialogflow sends (Fulfillment → Webhook → Basic auth).
# Use a long random password in production; leave both empty to disable auth.
WEBHOOK_USERNAME=dialogflow
WEBHOOK_PASSWORD=change-me-to-a-long-random-string

# --- Order API (defaults point at the mock) ---
ORDERS_API_URL=http://localhost:4000
ORDERS_API_KEY=dev-orders-key
ORDERS_API_TIMEOUT_MS=1500        # per attempt
WEBHOOK_BUDGET_MS=4000            # all order API calls for one webhook request; Dialogflow ES gives up at 5 s

# --- Store ---
STORE_TIMEZONE=America/New_York
SUPPORT_EMAIL=support@copperleaf.example
MAX_VERIFY_FAILURES=5             # failed order number + email checks per chat...
VERIFY_WINDOW_MINUTES=15          # ...within this window before the chat is locked

# --- Mock order API ---
MOCK_API_PORT=4000
MOCK_FAILURE_RATE=0               # share of requests answered with 503
MOCK_LATENCY_MS=80

# --- Local simulator ---
SIMULATOR_PORT=3000
WEBHOOK_URL=http://localhost:8080/webhook
AGENT_DIR=agent
BATCH_INSERT=enabled
RESIZE_IMAGE=enabled
CHECK_HEALTH=enabled
BATCH_INSERT=enabled
RESIZE_IMAGE=enabled
CHECK_HEALTH=enabled
BATCH_INSERT=enabled
RESIZE_IMAGE=enabled